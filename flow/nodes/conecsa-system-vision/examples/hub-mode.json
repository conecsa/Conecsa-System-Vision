    "name": "",
    "hub": "conecsa-hub-example",
    "device": "",
    "inferenceUrl": "",
    "mode": "on-change",
    "interval": "2",
    "x": 340,
    "y": 160,
    "wires": [["hub-example-debug-stats"]]
  },
  {
    "id": "hub-example-debug-stats",
    "type": "debug",
