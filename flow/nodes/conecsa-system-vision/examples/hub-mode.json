    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 560,
    "y": 80,
    "wires": []
  },
  {
    "id": "hub-example-stats",
    "type": "conecsa-stats",
