# IDEs
.idea/
.vscode/
# Claude Code: skills/, rules/ and settings.json are committed; only the
# per-user overrides and worktrees stay local.
.claude/settings.local.json
.claude/worktrees/
*.swp
*.swo
*~

# Python
__pycache__/
.mypy_cache/
.venv/

# Rust/Cargo. Cargo.lock files are COMMITTED on purpose: these crates are
# applications, so the lockfiles pin what actually ships (and CI's cargo-audit
# and cache keys read them).
/target/
**/*.rs.bk

# Node/NPM
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
tailwindcss

# Build outputs
/dist/
/build/

# Documentation site (generated by mkdocs / scripts/build-docs.sh)
/site/
/docs/rust/

# OS files
.DS_Store
Thumbs.db
*:Zone.Identifier

# Environment
.env
.env.local

#Logs
*.log

# Binary files
/bin/

# Local-dev fallbacks of the inference-service data volumes
# (see api/composition.py get_model_directory / get_detections_directory)
/uploaded_models/
/buffered_detections/

# SAM3 checkpoint (~3.5GB, HF-gated): downloaded locally, baked into the
# training-service image at build time — never committed.
training-service/assets/sam3.pt

# Generated proto stubs (compiled at image build by grpc_tools.protoc; locally
# regenerated by scripts/compile-proto.sh)
training-service/service/proto/*_pb2.py
training-service/service/proto/*_pb2.pyi
training-service/service/proto/*_pb2_grpc.py

# Local-dev stand-in for the production /data volumes (created by scripts/dev.sh)
/.dev-data/

